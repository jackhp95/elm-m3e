{
  "name": "m3e-builder-docs",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "gen": "run-s gen:vendor gen:reference gen:examples-config gen:examples-surfaces gen:examples-barrel gen:examples gen:samples",
    "gen:vendor": "node scripts/vendor-foundation.mjs",
    "gen:reference": "node scripts/extract-reference.mjs",
    "gen:examples-config": "node scripts/examples-gen/examples-to-elm.mjs",
    "gen:examples-surfaces": "node scripts/examples-gen/gen-record-build.mjs",
    "gen:examples-barrel": "node scripts/examples-gen/gen-barrel.mjs",
    "gen:examples": "node scripts/build-examples-data.mjs",
    "gen:examples-source": "node scripts/examples-gen/extract-matraic-examples.mjs",
    "gen:samples": "node scripts/samples-gen/extract-samples.mjs",
    "gen:pages": "elm-pages gen",
    "build:site": "elm-pages build",
    "test:examples-gen": "node --test scripts/examples-gen/lib/*.test.mjs",
    "test:samples-gen": "node --test scripts/samples-gen/lib/*.test.mjs",
    "test:roundtrip": "node --test scripts/roundtrip/*.test.mjs",
    "test:browser": "playwright test",
    "check:nav": "node scripts/check-nav.mjs",
    "check:drift": "node scripts/check-data-drift.mjs",
    "check:vendor": "node scripts/check-vendor-drift.mjs",
    "check:samples": "node scripts/samples-gen/verify-samples.mjs",
    "check:roundtrip": "node scripts/verify-roundtrip.mjs",
    "dev": "elm-pages dev",
    "serve": "node scripts/serve-dist.mjs dist",
    "check:review": "elm-review --config ../review --compiler node_modules/.bin/elm"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "elm": "^0.19.1-6",
    "elm-format": "^0.8.8",
    "elm-pages": "^3.5.0",
    "elm-review": "^2.13.5",
    "lamdera": "^0.19.1-1.4.0",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@m3e/web": "^2.7.0",
    "linkedom": "^0.18.13",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "overrides": {
      "tslib": "^2.8.1"
    }
  }
}
