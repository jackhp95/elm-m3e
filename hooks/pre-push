#!/bin/sh
# pre-push — run this repo's own gate before anything leaves the machine, then
# carry the gate's regenerated docs output along with the push.
#
# Local verification is the primary gate here, not GitHub Actions. The hook runs
# the same `npm run gate` (or `npm test`) a human would run, so a red tree cannot
# reach origin in the first place.
#
# Generated-docs auto-commit
# --------------------------
# `npm run gate` runs `build:site` (elm-pages build), which regenerates the
# TRACKED files under docs/.elm-pages/*. Historically the gate left those dirty
# and uncommitted, so a push never carried the prebuilt output and Netlify
# rebuilt everything from scratch. After a passing gate this hook stages ONLY the
# allowlisted generated paths (GEN_PATHS), commits them as a separate
# `chore(docs)` commit, and pushes that commit so origin — and Netlify — get the
# prebuilt output.
#
# SCOPE SAFETY: the hook stages ONLY the GEN_PATHS pathspec. It never runs
# `git add -A`/`git add .`, so a developer's unrelated uncommitted edits are
# never swept into this commit.
#
# THE GIT-REF WRINKLE: git snapshots each ref's SHA *before* invoking this hook,
# so a commit created inside the hook is NOT included in the same push (verified
# empirically). We therefore push the advanced ref ourselves under a recursion
# guard (PREPUSH_GENERATED_SELF) and then exit non-zero to abort the outer push's
# now-stale transfer. The trailing "failed to push some refs" line git prints is
# cosmetic — the real work (your commits + generated docs) is already on origin.
# Cost of this design: `git push` returns non-zero on the run that commits docs.
# The upside is Jack's intent — one `git push`, no manual re-push.
#
# Enable with `npm run hooks:install` (sets core.hooksPath=hooks). `postinstall`
# does it automatically, so a fresh `npm install` is enough.
#
# Escape hatches, in order of preference:
#   git push --no-verify      one-off bypass (skips gate AND docs auto-commit)
#   SKIP_GATE=1 git push      same, but explicit about what is being skipped
#
# Ref deletions skip the gate: there is no tree to verify, and `git push --delete`
# during branch cleanup should not pay for a full test run.

set -e

# Recursion guard: the docs self-push below re-fires this hook. Do nothing then —
# the tree is already gated and the generated commit is already made.
if [ "${PREPUSH_GENERATED_SELF:-}" = "1" ]; then
  exit 0
fi

# Allowlist of TRACKED generated paths the gate regenerates. Only these are ever
# staged/committed by this hook. docs/.elm-pages/ is the elm-pages codegen output
# (Pages.elm, Route/*, compiled/render.mjs, ...); its own .gitignore already
# excludes the untracked dist/ and functions CLI, so this pathspec cannot pull in
# ignored build artifacts. If the gate ever starts regenerating other TRACKED
# files, add them here — never widen to `.`/`-A`.
GEN_PATHS="docs/.elm-pages"

remote_name="$1"

if [ "${SKIP_GATE:-}" = "1" ]; then
  echo "pre-push: SKIP_GATE=1 — gate skipped."
  exit 0
fi

# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per ref being pushed.
# Capture it ONCE — it is a stream, and we need it again for the docs self-push.
refs=$(cat)

# An all-zero local sha means "delete this ref". If every line is a deletion,
# there is nothing to test. The here-doc feeds `while read` in the CURRENT shell
# (not a subshell), so the flags below survive the loop.
only_deletions=1
saw_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "$local_sha" ] && continue
  saw_ref=1
  case "$local_sha" in
    *[!0]*) only_deletions=0 ;;
  esac
done <<EOF
$refs
EOF

if [ "$saw_ref" = "1" ] && [ "$only_deletions" = "1" ]; then
  echo "pre-push: deletion-only push — gate skipped."
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -f package.json ]; then
  exit 0
fi

if node -e 'process.exit(require("./package.json").scripts?.gate ? 0 : 1)' 2>/dev/null; then
  script=gate
elif node -e 'process.exit(require("./package.json").scripts?.test ? 0 : 1)' 2>/dev/null; then
  script=test
else
  exit 0
fi

echo "pre-push: running \`npm run $script\` ..."
if ! npm run "$script"; then
  echo ""
  echo "pre-push: \`npm run $script\` FAILED — push aborted."
  echo "          Fix it, or bypass deliberately with: git push --no-verify"
  exit 1
fi

echo "pre-push: gate passed."

# --- carry the gate's regenerated docs along with the push ---------------------
# Stage ONLY the allowlisted generated paths. No-op if nothing changed.
git add -- $GEN_PATHS 2>/dev/null || true

if git diff --cached --quiet -- $GEN_PATHS 2>/dev/null; then
  # Nothing generated changed (or nothing tracked there). Un-stage defensively so
  # we never leave the allowlist staged, and let the normal push proceed.
  git reset -q -- $GEN_PATHS 2>/dev/null || true
  exit 0
fi

# Only the allowlist is staged at this point. Commit it as its own commit,
# bypassing hooks (--no-verify: a commit never re-fires pre-push, but this also
# skips any pre-commit hook).
git commit -q --no-verify -m "chore(docs): auto-commit generated elm-pages output [skip ci]"
new_sha=$(git rev-parse HEAD)
echo "pre-push: committed regenerated docs -> $new_sha"

# Push the advanced ref ourselves (git already snapshotted the pre-commit SHA for
# the outer push, so the outer push would NOT carry this commit). Only the ref
# that matches the currently checked-out branch gets the generated commit — that
# is the tree the gate actually built.
cur=$(git symbolic-ref --quiet --short HEAD || echo "")
pushed_self=0
if [ -n "$cur" ]; then
  printf '%s\n' "$refs" | while read -r local_ref _local_sha remote_ref _remote_sha; do
    [ -z "$local_ref" ] && continue
    if [ "$local_ref" = "refs/heads/$cur" ]; then
      echo "pre-push: pushing generated-docs commit on $cur ..."
      PREPUSH_GENERATED_SELF=1 git push "$remote_name" "$local_ref:$remote_ref"
    fi
  done
  pushed_self=1
fi

if [ "$pushed_self" = "1" ]; then
  echo ""
  echo "=================================================================="
  echo "pre-push: generated docs committed ($new_sha) and pushed."
  echo "          The trailing 'failed to push some refs' line below is"
  echo "          EXPECTED and benign: git's outer push used the pre-commit"
  echo "          ref snapshot, which is now stale. Everything (your commits"
  echo "          + generated docs) is already on origin. No re-push needed."
  echo "=================================================================="
  # Abort the outer push so git does not attempt the stale-snapshot transfer
  # (which would fail its compare-and-swap with a noisy 'remote rejected').
  exit 1
fi

# Detached HEAD or non-branch ref: we committed but cannot reliably self-push.
# Leave the commit in place and abort so the retry carries it.
echo ""
echo "pre-push: generated docs committed ($new_sha) but current ref is not a"
echo "          branch — could not auto-push. Re-run your push to send it."
exit 1
