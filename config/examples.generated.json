  "Button": {
    "examples": [
      {
        "title": "Variants",
        "code": "[ M3e.Component.Button.el { content = TypedHtml.text \"Elevated\", action = M3e.Action.none } [ M3e.Component.Button.variant M3e.Values.elevated ] []\n, M3e.Component.Button.el { content = TypedHtml.text \"Filled\", action = M3e.Action.none } [ M3e.Component.Button.variant M3e.Values.filled ] []\n, M3e.Component.Button.el { content = TypedHtml.text \"Tonal\", action = M3e.Action.none } [ M3e.Component.Button.variant M3e.Values.tonal ] []\n, M3e.Component.Button.el { content = TypedHtml.text \"Outlined\", action = M3e.Action.none } [ M3e.Component.Button.variant M3e.Values.outlined ] []\n, M3e.Component.Button.el { content = TypedHtml.text \"Text\", action = M3e.Action.none } [ M3e.Component.Button.variant M3e.Values.text ] []\n]",
        "section": "Variants"
      },
      {
        "title": "With a click action",
        "code": "M3e.Component.Button.el { content = TypedHtml.text \"Save\", action = M3e.Action.onClick Save } [ M3e.Component.Button.variant M3e.Values.filled ] []"
      },
      {
        "title": "With an icon",
        "code": "M3e.Component.Button.el\n    { content = TypedHtml.text \"Send\", action = M3e.Action.none }\n    [ M3e.Component.Button.variant M3e.Values.tonal ]\n    [ M3e.Component.Button.icon (M3e.Component.Icon.el [ M3e.Component.Icon.name \"send\" ] []) ]"
      }
    ],
    "docMeta": {
      "category": "Actions"
    }
  },
